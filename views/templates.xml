<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Mina bokningar-sidan -->
    <template id="car_rental_my_bookings" name="My Car Bookings">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h1 class="mb-3">My Car Bookings</h1>

                <t t-if="not bookings">
                    <div class="alert alert-info">
                        You have no bookings yet.
                    </div>
                </t>
                <t t-else="">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Car</th>
                                <th>Period</th>
                                <th>Days</th>
                                <th>Total price</th>
                                <th>Status</th>
                                <th>Invoice</th>
                                <th>Payment</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="bookings" t-as="booking">
                                <td>
                                    <t t-if="booking.car_id.image_1920">
                                        <img t-att-src="website.image_url(booking.car_id, 'image_1920')"
                                             style="max-height:60px; max-width:100px;"
                                             class="me-2 mb-1"/>
                                    </t>
                                    <strong t-esc="booking.car_id.name"/>
                                    <br/>
                                    <small t-esc="booking.car_id.license_plate"/>
                                </td>
                                <td>
                                    <span t-esc="booking.start_date"/> – <span t-esc="booking.end_date"/>
                                </td>
                                <td t-esc="booking.days"/>
                                <td>
                                    <span t-esc="booking.price_total"/> €
                                </td>
                                <td>
                                    <span t-esc="booking.state"/>
                                </td>

                                <!-- Visa fakturanummer om det finns -->
                                <td>
                                    <t t-if="booking.invoice_id">
                                        <span t-esc="booking.invoice_id.name"/>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted">No invoice</span>
                                    </t>
                                </td>
                                <td>
                                    <t t-if="booking.paid">
                                        <span class="badge bg-success">Paid</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-warning text-dark">Not paid</span>
                                        <br/>
                                        <a t-att-href="'/my/car_bookings/pay/%s' % booking.id"
                                           class="btn btn-sm btn-outline-primary mt-1">
                                            Mark as paid
                                        </a>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <!-- Lista bilar -->
    <template id="car_rental_car_website_list" name="Car Rental Website - List">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h1>Cars for Rent</h1>
                <div class="row mt-3">
                    <t t-foreach="cars" t-as="car">
                        <div class="col-12 col-md-4 mb-4">
                            <div class="card h-100">
                                <t t-if="car.image_1920">
                                    <img t-att-src="website.image_url(car, 'image_1920')"
                                         class="card-img-top img-fluid"
                                         alt="Car image"/>
                                </t>
                                <div class="card-body">
                                    <h3 class="card-title" t-esc="car.name"/>
                                    <p class="card-text">
                                        <strong>License plate:</strong>
                                        <span t-esc="car.license_plate"/>
                                    </p>
                                    <p class="card-text">
                                        <strong>Daily price:</strong>
                                        <span t-esc="car.daily_price"/> €
                                    </p>
                                    <a t-att-href="'/cars/book/%s' % car.id"
                                       class="btn btn-primary">
                                        Book this car
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- Bokningsformulär -->
    <template id="car_rental_booking_form" name="Car Rental Website - Booking Form">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h1>Book <span t-esc="car.name"/></h1>
                <form method="post"
                      t-att-action="'/cars/book/%s' % car.id"
                      class="mt-3">
                    <input type="hidden"
                           name="csrf_token"
                           t-att-value="request.csrf_token()"/>
                    <div class="form-group mb-2">
                        <label for="customer_name">Customer name</label>
                        <input type="text"
                               id="customer_name"
                               name="customer_name"
                               class="form-control"
                               required="required"/>
                    </div>
                    <div class="form-group mb-2">
                        <label for="customer_email">Email</label>
                        <input type="email"
                               id="customer_email"
                               name="customer_email"
                               class="form-control"
                               required="required"/>
                    </div>
                    <div class="form-group mb-2">
                        <label for="start_date">Start date</label>
                        <input type="date"
                               id="start_date"
                               name="start_date"
                               class="form-control"
                               required="required"/>
                    </div>
                    <div class="form-group mb-3">
                        <label for="end_date">End date</label>
                        <input type="date"
                               id="end_date"
                               name="end_date"
                               class="form-control"
                               required="required"/>
                    </div>
                    <button type="submit" class="btn btn-success">
                        Confirm booking
                    </button>
                </form>
            </div>
        </t>
    </template>

    <!-- Tack-sida -->
    <template id="car_rental_booking_thanks" name="Car Rental Website - Thanks">
        <t t-call="website.layout">
            <div class="container mt-4">
                <div class="alert alert-success">
                    <h1 class="h3 mb-2">Thank you!</h1>
                    <p class="mb-0">
                        Your booking has been registered. We will contact you soon.
                    </p>
                </div>
                <a href="/cars" class="btn btn-secondary mt-3">
                    Back to cars
                </a>
                <a href="/my/car_bookings" class="btn btn-primary mt-3 ms-2">
                    Go to my bookings
                </a>
            </div>
        </t>
    </template>

</odoo>
